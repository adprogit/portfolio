---
/**
 * L'échiquier du projet ray marcher, rendu en direct par le GPU.
 *
 * Le module de rendu ne se charge que quand la figure approche de l'écran :
 * il pèse plus lourd que le reste de la page, et la plupart des visiteurs ne
 * descendront pas jusqu'ici.
 *
 * Sans WebGPU, la figure se remplace par un texte qui dit pourquoi — et la
 * liste des coups reste lisible, elle ne dépend pas du rendu.
 */
import Icon from './Icon.astro';
import { GAME } from '../lib/chess/game';
import { useT } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useT(lang);

/** Les demi-coups sont numérotés à partir de 1 ; 0 est la position initiale. */
const moves = GAME.map((move) => move.san);
---

<figure class="reveal group" data-chess>
  <div class="overflow-hidden rounded border border-rule bg-paper-raised">
    {/* Le cadre accepte un PGN déposé ; il se souligne pendant le survol. */}
    <div
      data-chess-stage
      class="relative aspect-[4/3] bg-paper-sunken -outline-offset-4 outline-brand group-data-[dragging=true]:outline-2 group-data-[dragging=true]:outline-dashed"
    >
      {/* Petit badge « en direct », discret, par-dessus le rendu. */}
      <p
        data-chess-live
        class="glow pointer-events-none absolute top-3 left-3 z-10 inline-flex items-center gap-2 font-mono text-2xs tracking-[0.14em] text-brand uppercase"
      >
        <span
          class="h-1.5 w-1.5 animate-pulse rounded-full bg-brand"
          aria-hidden="true"
        ></span>
        {t('chess.live')}
      </p>
      <canvas
        data-chess-canvas
        class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-500 data-[ready=true]:opacity-100"
        role="img"
        aria-label={t('chess.canvas')}></canvas>

      {/* Remplacé par le canvas dès que le rendu démarre. */}
      <p
        data-chess-status
        data-unsupported={t('chess.unsupported')}
        data-failed={t('chess.failed')}
        class="absolute inset-0 flex items-center justify-center px-6 text-center text-sm text-pretty text-ink-soft"
      >
        {t('chess.loading')}
      </p>
    </div>

    <div data-chess-controls class="flex items-center gap-3 border-t border-rule px-4 py-3">
      <button
        type="button"
        data-chess-prev
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded border border-rule text-ink transition-colors hover:border-brand hover:text-brand disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-rule disabled:hover:text-ink"
        aria-label={t('chess.prev')}
        disabled
      >
        <Icon name="chevron-left" class="h-4 w-4" />
      </button>

      <button
        type="button"
        data-chess-next
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded border border-rule text-ink transition-colors hover:border-brand hover:text-brand disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-rule disabled:hover:text-ink"
        aria-label={t('chess.next')}
        disabled
      >
        <Icon name="chevron-right" class="h-4 w-4" />
      </button>

      {/* Le compteur est annoncé aux lecteurs d'écran à chaque changement. */}
      <p
        data-chess-move
        class="min-w-0 flex-1 truncate font-mono text-xs text-ink-soft"
        role="status"
        aria-live="polite"
      >
        {t('chess.start')}
      </p>

      <button
        type="button"
        data-chess-reset
        class="shrink-0 rounded-lg border border-line px-2.5 py-1.5 font-mono text-xs text-ink-soft transition-colors hover:border-brand hover:text-brand disabled:cursor-not-allowed disabled:opacity-40"
        disabled>{t('chess.reset')}</button
      >
    </div>

    {/*
      La partie affichée, et de quoi en charger une autre. Le fichier est lu
      dans le navigateur : rien ne part, rien n'est gardé.
    */}
    <div data-chess-controls class="flex items-center gap-3 border-t border-rule px-4 py-2.5">
      <p
        data-chess-game
        data-bad={t('chess.bad')}
        data-too-big={t('chess.tooBig')}
        class="min-w-0 flex-1 truncate text-xs text-ink-soft"
      >
        {t('chess.origin')}
      </p>
      <label
        class="shrink-0 cursor-pointer rounded-lg border border-line px-2.5 py-1.5 font-mono text-xs text-ink-soft transition-colors focus-within:border-brand focus-within:text-brand hover:border-brand hover:text-brand"
      >
        {t('chess.load')}
        <input data-chess-file type="file" accept=".pgn,text/plain,application/x-chess-pgn" class="sr-only" />
      </label>
    </div>
  </div>

  <figcaption class="mt-3 text-sm leading-relaxed text-pretty text-ink-soft">
    {t('chess.caption')}
  </figcaption>
</figure>

<script
  is:inline
  type="application/json"
  data-chess-moves
  set:html={JSON.stringify(moves).replace(/</g, '\\u003c')}
/>

<script>
  import type { ChessHandle } from '../lib/chess';

  const setup = () => {
    const root = document.querySelector<HTMLElement>('[data-chess]');
    // `setup` tourne au chargement *et* sur `astro:page-load`, qui se déclenche
    // aussi à la première visite : sans ce drapeau, deux rendus se montaient
    // sur le même canvas, chacun avec ses écouteurs et sa partie.
    if (!root || root.dataset.chessBound) return;
    root.dataset.chessBound = '1';

    const canvas = root.querySelector<HTMLCanvasElement>('[data-chess-canvas]');
    const status = root.querySelector<HTMLElement>('[data-chess-status]');
    const prev = root.querySelector<HTMLButtonElement>('[data-chess-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-chess-next]');
    const reset = root.querySelector<HTMLButtonElement>('[data-chess-reset]');
    const label = root.querySelector<HTMLElement>('[data-chess-move]');
    const game = root.querySelector<HTMLElement>('[data-chess-game]');
    const file = root.querySelector<HTMLInputElement>('[data-chess-file]');
    if (!canvas || !status || !prev || !next || !reset || !label || !game || !file) return;

    const data = document.querySelector<HTMLScriptElement>('[data-chess-moves]');
    let moves: string[] = data ? JSON.parse(data.textContent ?? '[]') : [];

    const strings = {
      start: label.textContent ?? '',
      unsupported: status.dataset.unsupported ?? '',
      failed: status.dataset.failed ?? '',
    };

    let handle: ChessHandle | null = null;

    /** « 12. O-O-O » ou « 12… Rd8 » selon le camp qui vient de jouer. */
    const describe = (ply: number) => {
      if (ply === 0) return strings.start;
      const san = moves[ply - 1] ?? '';
      const number = Math.floor((ply - 1) / 2) + 1;
      return ply % 2 === 1 ? `${number}. ${san}` : `${number}… ${san}`;
    };

    const refresh = () => {
      if (!handle) return;
      const { ply, plyCount } = handle;
      prev.disabled = ply === 0;
      next.disabled = ply === plyCount - 1;
      reset.disabled = ply === 0;
      label.textContent = describe(ply);
    };

    const go = (ply: number) => {
      handle?.setPly(ply);
      refresh();
    };

    prev.addEventListener('click', () => go((handle?.ply ?? 0) - 1));
    next.addEventListener('click', () => go((handle?.ply ?? 0) + 1));
    reset.addEventListener('click', () => go(0));

    /*
     * Un PGN déposé ou choisi : lu ici, jamais envoyé. Ce qui en sort — noms,
     * coups — ne s'affiche qu'en texte. Une partie illisible laisse la
     * précédente en place et dit où la lecture a buté.
     */
    const loadFile = async (picked: File | undefined) => {
      if (!picked || !handle) return;
      const { MAX_PGN_BYTES, parsePgn, PgnError } = await import('../lib/chess/pgn');

      if (picked.size > MAX_PGN_BYTES) {
        label.textContent = game.dataset.tooBig ?? '';
        return;
      }
      try {
        const parsed = parsePgn(await picked.text());
        if (!parsed.moves.length) throw new PgnError(1, '—');
        handle.load(parsed.moves, parsed.start);
        moves = parsed.moves.map((move) => move.san);
        game.textContent =
          [parsed.players || picked.name, parsed.result].filter(Boolean).join(' · ');
        refresh();
      } catch (error) {
        const where = error instanceof PgnError ? error : new PgnError(0, '');
        label.textContent = (game.dataset.bad ?? '')
          .replace('{n}', String(where.ply))
          .replace('{san}', where.san);
      }
    };

    file.addEventListener('change', () => {
      void loadFile(file.files?.[0]);
      file.value = '';
    });

    // Glisser-déposer sur la figure. `dragleave` se déclenche aussi en passant
    // d'un enfant à l'autre : on ne retire l'accent qu'en sortant vraiment.
    root.addEventListener('dragover', (event) => {
      if (!handle || !event.dataTransfer?.types.includes('Files')) return;
      event.preventDefault();
      event.dataTransfer.dropEffect = 'copy';
      root.dataset.dragging = 'true';
    });
    root.addEventListener('dragleave', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) delete root.dataset.dragging;
    });
    root.addEventListener('drop', (event) => {
      if (!handle) return;
      event.preventDefault();
      delete root.dataset.dragging;
      void loadFile(event.dataTransfer?.files[0]);
    });

    // Le module de rendu ne descend qu'à l'approche de la figure.
    const start = async () => {
      const { mountChessBoard } = await import('../lib/chess');
      const mounted = await mountChessBoard(canvas);

      if (typeof mounted === 'string') {
        /*
         * Sans WebGPU, la figure se replie sur sa phrase : le badge « en
         * direct » ne doit pas rester allumé sur un rendu qui n'a pas lieu, et
         * une barre de commandes qui ne commande rien n'a pas à occuper
         * l'écran. La mise en forme du repli vit dans `global.css`.
         */
        status.textContent = strings[mounted];
        root.dataset.chessState = 'unsupported';
        return;
      }
      handle = mounted;
      status.remove();
      refresh();
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void start();
        },
        { rootMargin: '300px 0px' }
      );
      observer.observe(root);
    } else {
      void start();
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        handle?.destroy();
        handle = null;
      },
      { once: true }
    );
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
