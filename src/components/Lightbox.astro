---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useT(lang);
---

{/* Un seul lightbox par page. <dialog> gère nativement le focus et Échap. */}
<dialog
  id="lightbox"
  aria-label={t('lightbox.label')}
  class="m-auto w-full max-w-[min(96vw,72rem)] bg-transparent p-0 text-white"
>
  <div class="flex flex-col gap-3 p-3 sm:p-5">
    <div class="flex items-center justify-between gap-4">
      <p id="lightbox-title" class="font-mono text-xs text-white sm:text-sm"></p>
      <button
        type="button"
        id="lightbox-close"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded border border-white/30 text-white transition-colors hover:border-white"
        aria-label={t('lightbox.close')}
      >
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>

    <div class="relative flex items-center justify-center">
      {/* Pas de `src` tant qu'aucune image n'est ouverte : un `src` vide est invalide. */}
      <img
        id="lightbox-image"
        alt=""
        class="max-h-[72vh] w-auto max-w-full object-contain"
      />

      <button
        type="button"
        id="lightbox-prev"
        class="absolute left-1 inline-flex h-11 w-11 items-center justify-center rounded border border-white/30 text-white transition-colors hover:border-white sm:left-3"
        aria-label={t('lightbox.prev')}
      >
        <Icon name="chevron-left" class="h-6 w-6" />
      </button>

      <button
        type="button"
        id="lightbox-next"
        class="absolute right-1 inline-flex h-11 w-11 items-center justify-center rounded border border-white/30 text-white transition-colors hover:border-white sm:right-3"
        aria-label={t('lightbox.next')}
      >
        <Icon name="chevron-right" class="h-6 w-6" />
      </button>
    </div>

    <div class="flex items-baseline justify-between gap-4">
      <p id="lightbox-caption" class="text-sm text-balance text-white" aria-live="polite">
      </p>
      <p id="lightbox-counter" class="shrink-0 font-mono text-xs text-white"></p>
    </div>
  </div>
</dialog>

<script>
  interface Shot {
    src: string;
    alt: string;
    caption: string;
    width: number;
    height: number;
    title: string;
  }

  // Tout passe par délégation sur `document` : les transitions de vue
  // remplacent le DOM, donc on ne garde aucune référence entre deux pages.
  let shots: Shot[] = [];
  let index = 0;
  let lastFocused: HTMLElement | null = null;

  const dialog = () => document.getElementById('lightbox') as HTMLDialogElement | null;

  const render = () => {
    const shot = shots[index];
    const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
    if (!shot || !image) return;

    image.src = shot.src;
    image.alt = shot.alt;
    image.width = shot.width;
    image.height = shot.height;

    const caption = document.getElementById('lightbox-caption');
    const title = document.getElementById('lightbox-title');
    const counter = document.getElementById('lightbox-counter');
    if (caption) caption.textContent = shot.caption;
    if (title) title.textContent = shot.title;
    if (counter) counter.textContent = `${index + 1} / ${shots.length}`;

    const single = shots.length < 2;
    document.getElementById('lightbox-prev')?.classList.toggle('hidden', single);
    document.getElementById('lightbox-next')?.classList.toggle('hidden', single);
  };

  const move = (delta: number) => {
    if (shots.length < 2) return;
    index = (index + delta + shots.length) % shots.length;
    render();
  };

  /** Chaque page projet publie ses visuels dans un <script type="application/json">. */
  const readGroup = (name: string): Shot[] => {
    const node = document.querySelector<HTMLScriptElement>(
      `script[data-lightbox-group="${name}"]`
    );
    if (!node?.textContent) return [];
    try {
      return JSON.parse(node.textContent) as Shot[];
    } catch {
      return []; // données invalides : on ignore ce groupe
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const modal = dialog();
    if (!modal) return;

    const trigger = target.closest<HTMLElement>('[data-lightbox-open]');
    if (trigger) {
      const list = readGroup(trigger.dataset.group ?? '');
      if (!list.length) return;

      shots = list;
      index = Math.min(Number(trigger.dataset.index ?? 0), list.length - 1);
      lastFocused = trigger;
      render();
      modal.showModal();
      return;
    }

    if (target.closest('#lightbox-close')) modal.close();
    else if (target.closest('#lightbox-prev')) move(-1);
    else if (target.closest('#lightbox-next')) move(1);
    // Clic sur le fond (hors contenu) = fermeture.
    else if (target === modal) modal.close();
  });

  document.addEventListener('keydown', (event) => {
    const modal = dialog();
    if (!modal?.open) return;
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'ArrowRight') {
      event.preventDefault();
      move(1);
    }
  });

  // Échap est géré par <dialog> : on rend juste le focus à l'élément d'origine.
  const bindClose = () => {
    dialog()?.addEventListener('close', () => {
      lastFocused?.focus();
      lastFocused = null;
    });
  };

  bindClose();
  document.addEventListener('astro:page-load', bindClose);
</script>
