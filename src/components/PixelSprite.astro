---
/**
 * Un sprite de projet : une petite animation en pixels, en SVG statique.
 *
 * Sûreté d'abord, puisque ce composant pose du SVG dans chaque ligne de
 * l'accueil : aucun script, aucun attribut d'événement, aucune ressource
 * externe ni `data:` URI, aucun `foreignObject` — seulement des `<path>` faits
 * de rectangles aux coordonnées entières, calculés à la compilation par
 * `src/lib/sprites.ts`.
 * Le seul style en ligne est le rang de la première image (`--f`) et la taille de la grille
 * (`--px-n`), deux nombres. Rien ne vient d'une donnée extérieure.
 *
 * C'est un décor : le lien porte déjà le titre du projet, donc le SVG est
 * `aria-hidden` et ne prend pas le focus.
 */
import { FRAMES, type Layer } from '../lib/pixel';
import { sprites } from '../lib/sprites';

interface Props {
  slug: string;
}

const make = sprites[Astro.props.slug];
const sprite = make?.();
if (sprite && sprite.frames.length !== FRAMES) {
  throw new Error(`PixelSprite : ${Astro.props.slug} doit avoir ${FRAMES} images.`);
}

// Les images identiques qui se suivent n'en font qu'une, visible plus
// longtemps : une scène qui se fige sur sa fin ne se répète pas dans le HTML.
const runs: { start: number; span: number; paths: ReturnType<Layer['paths']> }[] = [];
for (const [f, frame] of (sprite?.frames ?? []).entries()) {
  const paths = frame.paths();
  const last = runs.at(-1);
  if (last && JSON.stringify(last.paths) === JSON.stringify(paths)) last.span++;
  else runs.push({ start: f, span: 1, paths });
}
---

{sprite && (
  <svg
    class="px-sprite"
    viewBox={`0 0 ${sprite.size} ${sprite.size}`}
    style={`--px-n: ${sprite.size}`}
    aria-hidden="true"
    focusable="false"
  >
    <g>
      {sprite.base.paths().map(({ role, d }) => <path class={`px-${role}`} d={d} />)}
    </g>
    {runs.map(({ start, span, paths }) => (
      <g class={`px-frame px-s${span}`} style={`--f: ${start}`}>
        {paths.map(({ role, d }) => <path class={`px-${role}`} d={d} />)}
      </g>
    ))}
  </svg>
)}
