---
/**
 * Un projet, en une carte : une case d'écran carrée où tourne son sprite, puis
 * le titre, une ligne de quoi, la pile technique.
 *
 * Les cartes remplacent la liste. Ce ne sont toujours pas des vignettes : la
 * case ne montre pas une capture du projet, elle rejoue en 32 × 32 pixels ce
 * qu'il fait — un rayon qui marche, un masque qui s'affine, un tube qui coule
 * (`src/lib/sprites.ts`).
 *
 * Au repos, tout est neutre, sprite compris. Au survol, la carte prend
 * l'accent du projet — le cadre, le titre, et les pixels « accent » du
 * sprite —, et les chiffres du projet remontent à la place de sa pile
 * technique, dans la même cellule de grille : rien ne se décale.
 *
 * Le relevé est `aria-hidden` et la pile reste lisible aux lecteurs d'écran ;
 * le sprite est un décor, `aria-hidden` lui aussi.
 */
import type { ResolvedProject } from '../data/projects';
import { toneVar } from '../data/projects';
import { projectPath, type Locale } from '../i18n/config';
import { useT } from '../i18n/ui';
import PixelSprite from './PixelSprite.astro';

interface Props {
  project: ResolvedProject;
  lang: Locale;
}

const { project, lang } = Astro.props;
const t = useT(lang);
---

<a
  href={projectPath(lang, project.slug)}
  transition:name={`tone-${project.slug}`}
  class="card group flex h-full flex-col"
  style={`--row-accent: ${toneVar[project.tone]}`}
>
  <span class="card-art">
    <PixelSprite slug={project.slug} />
    {/* Dans le coin de l'écran : à côté d'un titre long, la mention
        débordait d'une colonne étroite. */}
    {project.status === 'wip' && (
      <span class="row-year absolute top-2 right-2 font-mono text-2xs tracking-[0.16em] text-ink-soft uppercase">
        {t('project.wip')}
      </span>
    )}
  </span>

  <span class="row-title mt-3 block font-mono text-base font-semibold tracking-tight text-balance text-ink-strong sm:text-lg">
    {project.title}
  </span>

  <span class="mt-1 block text-xs leading-relaxed text-pretty text-ink-soft sm:text-sm">
    {project.tagline}
  </span>

  {/* Sur téléphone, deux cartes de front : la pile n'y tiendrait pas, et le
      titre et la ligne suffisent pour choisir où aller. */}
  <span class="row-readout mt-2 hidden truncate font-mono text-xs sm:grid">
    <span class="row-tech truncate text-ink-soft">{project.tech.join('  ·  ')}</span>
    {project.metrics && (
      <span class="row-metrics truncate" aria-hidden="true">
        {project.metrics.join('  ·  ')}
      </span>
    )}
  </span>
</a>
