---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-7 w-7 items-center justify-center rounded text-ink-soft transition-colors hover:text-ink-strong"
  aria-label={t('a11y.theme')}
  aria-pressed="false"
>
  <Icon name="moon" class="h-4 w-4 dark:hidden" />
  <Icon name="sun" class="hidden h-4 w-4 dark:block" />
</button>

<script>
  const root = document.documentElement;

  const sync = () => {
    document
      .getElementById('theme-toggle')
      ?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  };

  const toggle = () => {
    const isDark = root.classList.toggle('dark');
    root.style.colorScheme = isDark ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      // Stockage refusé : le choix vaut pour cette page, sans être retenu.
    }
    sync();
    // Le rendu WebGPU du plateau suit la palette du site.
    document.dispatchEvent(new CustomEvent('themechange'));
  };

  // Délégation : le bouton est remplacé à chaque transition de vue.
  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement | null)?.closest('#theme-toggle')) toggle();
  });

  sync();
  document.addEventListener('astro:page-load', sync);
</script>
