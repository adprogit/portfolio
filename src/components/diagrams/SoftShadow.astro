---
/**
 * Chapitre 08 — les ombres douces, en deux lectures.
 *
 * Au-dessus du sol, le mécanisme : un point de la pénombre lance son rayon
 * d'ombre vers la lumière, et on trace les sphères de sa marche. Le cercle
 * marqué est le pas où k·h/t a été le plus petit — celui qui décide de la
 * quantité de lumière reçue.
 *
 * Sous le sol, le résultat : la lumière reçue en chaque point, une case par
 * échantillon, pour deux valeurs de k. La bande k = 32 (celle du moteur) passe
 * de l'ombre à la lumière presque d'un coup ; la bande k = 4 s'éclaire
 * progressivement. C'est la même fonction, `softShadow`, point par point.
 *
 * La lumière reçue est rendue par l'opacité de l'aplat jaune : c'est une
 * donnée, pas un effet, comme dans les cartes de chaleur du banc d'essai.
 */
import type { Locale } from '../../i18n/config';
import { useT } from '../../i18n/ui';
import { circleSdf, pt, softShadow, softShadowTrace, type Vec } from '../../lib/diagram-geometry';

interface Props { lang: Locale }
const t = useT(Astro.props.lang);

const light: Vec = [566, 34];
const occluder = { c: [292, 116] as Vec, r: 32 };
const scene = circleSdf(occluder);
const groundY = 176;
const x0 = 40;
const x1 = 604;
const cell = 3;
const xs = Array.from({ length: Math.floor((x1 - x0) / cell) }, (_, i) => x0 + i * cell);

const band = (softness: number) =>
  xs.map((x) => ({ x, s: softShadow([x, groundY], light, scene, { softness }) }));
const hard = band(32);
const soft = band(4);

// Le point montré : au milieu de la pénombre large.
const probe = soft.find(({ s }) => s >= 0.45 && s <= 0.8) ?? soft[0];
const trace = softShadowTrace([probe.x, groundY], light, scene, { softness: 4 });
const min = trace.steps[trace.minIndex];

const strips = [
  { y: 190, label: 'k = 32', samples: hard },
  { y: 214, label: 'k = 4', samples: soft },
];
---

<svg class="diagram-svg" viewBox="0 0 640 250" role="img" aria-label={t('diagram.softShadow.alt')}>
  <line class="d-line" x1={x0} y1={groundY} x2={x1} y2={groundY} />
  <circle class="d-shape" cx={occluder.c[0]} cy={occluder.c[1]} r={occluder.r} />

  {/* Le rayon d'ombre et sa marche. */}
  <line class="d-rule" x1={probe.x} y1={groundY} x2={light[0]} y2={light[1]} />
  {trace.steps.map(({ p, r }, i) => (
    <g class="d-anim" style={`--i: ${i}`}>
      <circle class="d-probe" cx={p[0].toFixed(1)} cy={p[1].toFixed(1)} r={r.toFixed(1)} />
    </g>
  ))}
  <circle class="d-min" cx={min.p[0].toFixed(1)} cy={min.p[1].toFixed(1)} r={min.r.toFixed(1)} />
  <circle class="d-dot-accent" cx={probe.x} cy={groundY} r="3.5" />
  <circle class="d-dot-light" cx={light[0]} cy={light[1]} r="6" />

  {/* La lumière reçue, une case par échantillon. */}
  {strips.map((strip) => (
    <g>
      <rect class="d-strip-frame" x={x0} y={strip.y} width={x1 - x0} height="14" />
      {strip.samples.map(({ x, s }) =>
        s > 0 ? <rect class="d-lit" x={x} y={strip.y} width={cell + 0.3} height="14" fill-opacity={s.toFixed(3)} /> : null
      )}
      <text class="d-label" x={x0 - 8} y={strip.y + 10.5} text-anchor="end">{strip.label}</text>
    </g>
  ))}

  <text class="d-label" x={light[0] - 12} y={light[1] - 10} text-anchor="end">{t('diagram.light')}</text>
  <text class="d-label" x={occluder.c[0]} y={occluder.c[1] - occluder.r - 10} text-anchor="middle">
    {t('diagram.occluder')}
  </text>
  <text class="d-label-accent" x={min.p[0] + min.r + 8} y={min.p[1] + 4}>min k · h / t</text>
  <text class="d-label-accent" x={probe.x} y={groundY - 10} text-anchor="middle">{t('diagram.penumbra')}</text>
  <text class="d-label" x={x1} y={244} text-anchor="end">{t('diagram.received')}</text>
</svg>
