---
/**
 * Le cadre d'un panneau : titre, graduations, grille légère, libellés d'axes.
 * Les données sont dessinées par-dessus, dans la zone `MARGIN` → `PANEL`.
 */
import { MARGIN, PANEL, tickLabel, type Scale } from '../../lib/plot';

interface Props {
  title?: string;
  sx: Scale;
  sy: Scale;
  xLabel: string;
  yLabel: string;
}

const { title, sx, sy, xLabel, yLabel } = Astro.props;
const [left, right] = [MARGIN.left, PANEL.width - MARGIN.right];
const [top, bottom] = [MARGIN.top, PANEL.height - MARGIN.bottom];
---

{title && <text class="p-title" x={left} y={14}>{title}</text>}

{sx.ticks.map((t) => (
  <g>
    <line class="p-grid" x1={sx(t)} y1={top} x2={sx(t)} y2={bottom} />
    <text class="p-tick" x={sx(t)} y={bottom + 13} text-anchor="middle">{tickLabel(t, sx.log)}</text>
  </g>
))}
{sy.ticks.map((t) => (
  <g>
    <line class="p-grid" x1={left} y1={sy(t)} x2={right} y2={sy(t)} />
    <text class="p-tick" x={left - 5} y={sy(t) + 3.5} text-anchor="end">{tickLabel(t, sy.log)}</text>
  </g>
))}

<line class="p-axis" x1={left} y1={bottom} x2={right} y2={bottom} />
<line class="p-axis" x1={left} y1={top} x2={left} y2={bottom} />

<text class="p-label" x={(left + right) / 2} y={PANEL.height - 6} text-anchor="middle">{xLabel}</text>
<text
  class="p-label"
  transform={`translate(11 ${(top + bottom) / 2}) rotate(-90)`}
  text-anchor="middle">{yLabel}</text
>
