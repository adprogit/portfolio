---
/** Notes en anglais : /notes/<slug>/ */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteBody from '../../components/NoteBody.astro';
import { noteRoutes, type ResolvedNote } from '../../data/notes';
import { defaultLocale } from '../../i18n/config';

export function getStaticPaths() {
  return noteRoutes
    .filter((route) => route.locale === defaultLocale)
    .map((route) => ({ params: { slug: route.slug }, props: { note: route.note } }));
}

const { note } = Astro.props as { note: ResolvedNote };
---

<BaseLayout
  lang={defaultLocale}
  back
  title={`${note.title} ${note.titleAccent} · ${note.kicker}`}
  description={note.description}
>
  <NoteBody note={note} lang={defaultLocale} />
</BaseLayout>
